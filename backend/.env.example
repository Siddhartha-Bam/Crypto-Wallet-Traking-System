# Server
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/crypto_trace?schema=public

# Blockchain data providers (free tier keys)
# https://etherscan.io/apis — free registration
BLOCKCHAIN_API_KEY=
RPC_URL=

# Etherscan V2 multichain endpoint (single key covers all EVM chains)
ETHERSCAN_BASE_URL=https://api.etherscan.io/v2/api

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
