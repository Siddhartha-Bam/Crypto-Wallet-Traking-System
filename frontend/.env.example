# Frontend Environment Configuration
# Copy this file to .env.local to override defaults

# Set to 'false' to connect to real backend (requires FastAPI running on port 4000)
# Default: true (mock mode - no backend required)
VITE_USE_MOCK_DATA=true

# Backend API URL (only used when VITE_USE_MOCK_DATA=false)
# VITE_API_URL=http://localhost:4000/api